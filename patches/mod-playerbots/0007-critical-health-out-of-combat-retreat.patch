+
+#include "RetreatFromDangerStrategy.h"
+
+#include "Playerbots.h"
+
+void RetreatFromDangerStrategy::InitTriggers(std::vector<TriggerNode*>& triggers)
+{
+    // infra: the stock "flee" action needs a combat target to pick a
+    // direction, and a bot that revives at critical health has none - it is
+    // out of combat by definition immediately after resurrecting. "retreat
+    // from danger" (MovementActions.h) asks FleeManager directly and needs no
+    // target. This is the second half of the fix for infra's wow-dev death
+    // loop; the first half is the attacker filter in GrindTargetValue.cpp.
+    //
+    // infra: RELEVANCE MUST BE >= 100, NOT JUST HIGH. Confirmed live (stderr
+    // logging, wow-dev, 2026-08-28): this action never once fired for an
+    // isolated bot with no real player nearby, even though it fired
+    // correctly for others. Engine::ProcessTriggers has a second, SEPARATE
+    // gate from action priority: "if (minimal && node->getFirstRelevance() <
+    // 100) continue;" - and PlayerbotAI::UpdateAI passes minimal=true
+    // whenever AllowActivity() is false, which for an unwatched bot is most
+    // of the time. ACTION_EMERGENCY + 8 = 98, strictly less than 100, so this
+    // trigger's handler was silently dropped on every minimal tick. 100 flat,
+    // not a further offset, so the intent (clear the minimal-mode floor,
+    // nothing more) stays legible to the next reader.
+    triggers.push_back(
+        new TriggerNode("critical health", { NextAction("retreat from danger", 100.0f) }));
+}
