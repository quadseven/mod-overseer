diff --git a/src/Ai/Base/Actions/MovementActions.h b/src/Ai/Base/Actions/MovementActions.h
index cbf44550..16b840f0 100644
--- a/src/Ai/Base/Actions/MovementActions.h
+++ b/src/Ai/Base/Actions/MovementActions.h
@@ -98,6 +98,31 @@ private:
     float distance;
 };
 
+// infra: FleeAction (above) needs AI_VALUE(Unit*, "current target") to pick a
+// direction, and that value is only ever set by combat target-selection - it
+// stays empty for a bot that just revived out of combat at critical health,
+// which is exactly the family's death-loop state (revive at 1 hp next to
+// whatever killed them, "current target" unset, "flee" a no-op, nothing else
+// moves them, the same creature kills them again). FleeManager itself
+// (Mgr/Move/FleeManager.h) needs no target at all - it scores candidate
+// points by distance from nearby creatures and only takes an angle to seed
+// the search, not to aim away from one specific unit. This class calls it
+// directly so recovering from critical health does not depend on a combat
+// target existing.
+class RetreatFromDangerAction : public MovementAction
+{
+public:
+    RetreatFromDangerAction(PlayerbotAI* botAI, float distance = sPlayerbotAIConfig.fleeDistance)
+        : MovementAction(botAI, "retreat from danger"), distance(distance)
+    {
+    }
+
+    bool Execute(Event event) override;
+
+private:
+    float distance;
+};
+
 class FleeWithPetAction : public MovementAction
 {
 public:
diff --git a/src/Ai/Base/Strategy/FleeStrategy.cpp b/src/Ai/Base/Strategy/FleeStrategy.cpp
index d8919309..a5ace870 100644
--- a/src/Ai/Base/Strategy/FleeStrategy.cpp
+++ b/src/Ai/Base/Strategy/FleeStrategy.cpp
@@ -15,6 +15,17 @@ void FleeStrategy::InitTriggers(std::vector<TriggerNode*>& triggers)
         new TriggerNode("outnumbered", { NextAction("flee", ACTION_EMERGENCY + 9) }));
     triggers.push_back(
         new TriggerNode("critical health", { NextAction("flee", ACTION_MEDIUM_HEAL) }));
+
+    // infra: "flee" (above) needs a combat target to pick a direction and is
+    // only ever added to the COMBAT engine (AiFactory::AddDefaultCombatStrategies),
+    // never to the non-combat one. A bot that revives at critical health has
+    // no combat target yet - it is out of combat by definition immediately
+    // after resurrecting - so nothing here has ever applied to that moment.
+    // This is the second half of the fix for infra's wow-dev death loop:
+    // "flee" is now also added to the non-combat engine (AiFactory.cpp), and
+    // this is the action that actually works without a target once it is.
+    triggers.push_back(
+        new TriggerNode("critical health", { NextAction("retreat from danger", ACTION_EMERGENCY + 8) }));
 }
 
 void FleeFromAddsStrategy::InitTriggers(std::vector<TriggerNode*>& triggers)
diff --git a/src/Ai/Base/Value/GrindTargetValue.cpp b/src/Ai/Base/Value/GrindTargetValue.cpp
index c8cdfbeb..fcd5f074 100644
--- a/src/Ai/Base/Value/GrindTargetValue.cpp
+++ b/src/Ai/Base/Value/GrindTargetValue.cpp
@@ -44,6 +44,24 @@ Unit* GrindTargetValue::FindTargetForGrinding(uint32 assistCount)
         if (!unit || !unit->IsAlive())
             continue;
 
+        // infra: an attacker was returned here unconditionally, bypassing
+        // the level-gap and elite checks applied a few lines below to every
+        // OTHER candidate. That is how a level 15-19 bot chooses to keep
+        // fighting a creature that already proved lethal: the moment it is
+        // in the "attackers" list, this loop hands it back as the grind
+        // target with zero safety filtering, every single tick, including
+        // the tick immediately after reviving next to it. Applying the same
+        // two checks here that already gate "possible targets" closes that
+        // gap without touching anything else in this function.
+        if (!bot->InBattleground() && (int)unit->GetLevel() - (int)bot->GetLevel() > 4 &&
+            !unit->GetGUID().IsPlayer())
+            continue;
+
+        if (Creature* creature = unit->ToCreature())
+            if (CreatureTemplate const* creatureTemplate = creature->GetCreatureTemplate())
+                if (creatureTemplate->rank > CREATURE_ELITE_NORMAL && !AI_VALUE(bool, "can fight elite"))
+                    continue;
+
         return unit;
     }
 
