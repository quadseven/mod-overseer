@@ -1840,6 +1840,22 @@ bool FleeAction::isUseful()
     return true;
 }
 
+bool RetreatFromDangerAction::Execute(Event /*event*/)
+{
+    // followAngle is unused by FleeManager's own destination search (see the
+    // class declaration in MovementActions.h for why) - 0.0f is a
+    // placeholder, not a chosen direction.
+    FleeManager manager(bot, distance, 0.0f);
+    if (!manager.isUseful())
+        return false;
+
+    float rx, ry, rz;
+    if (!manager.CalculateDestination(&rx, &ry, &rz))
+        return false;
+
+    return MoveTo(bot->GetMapId(), rx, ry, rz);
+}
