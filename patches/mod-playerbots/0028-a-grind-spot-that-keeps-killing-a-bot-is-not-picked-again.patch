 #ifndef PLAYERBOTS_NEWRPGINFO_H
 #define PLAYERBOTS_NEWRPGINFO_H
 
+#include <cmath>
+#include <ctime>
 #include <unordered_set>
 
 #include "Define.h"
@@ -19,6 +21,87 @@
 
 using NewRpgStatusTransitionProb = std::vector<std::vector<int>>;
 
+// Where this bot died lately, so a grind spot that keeps killing it is not
+// picked again. Two deaths within kRadius yards inside kWindow seconds make
+// that ground "hot" for this bot; a hot spot, or a spot whose straight line
+// from the bot passes through hot ground, is skipped while any other spot
+// exists. In memory only: a restart forgets it, which is harmless.
+struct NewRpgDeathMemory
+{
+    struct Mark
+    {
+        uint32 map{0};
+        float x{0}, y{0};
+        time_t at{0};
+    };
+
+    static constexpr time_t kWindow = 6 * 60 * 60;
+    static constexpr float kRadius = 150.0f;
+    static constexpr float kRouteRadius = 100.0f;
+    static constexpr size_t kHot = 2;
+    static constexpr size_t kCap = 24;
+
+    std::vector<Mark> marks;
+
+    void Record(uint32 map, float x, float y, time_t now)
+    {
+        std::vector<Mark> kept;
+        for (Mark const& m : marks)
+            if (now - m.at < kWindow)
+                kept.push_back(m);
+        kept.push_back(Mark{map, x, y, now});
+        if (kept.size() > kCap)
+            kept.erase(kept.begin(), kept.begin() + (kept.size() - kCap));
+        marks = std::move(kept);
+    }
+
+    static float Dist2d(float ax, float ay, float bx, float by)
+    {
+        return std::sqrt((ax - bx) * (ax - bx) + (ay - by) * (ay - by));
+    }
+
+    // Distance from point p to the segment a-b.
+    static float SegmentDist(float px, float py, float ax, float ay, float bx, float by)
+    {
+        float const dx = bx - ax, dy = by - ay;
+        float const len2 = dx * dx + dy * dy;
+        float t = len2 > 0.0f ? ((px - ax) * dx + (py - ay) * dy) / len2 : 0.0f;
+        t = t < 0.0f ? 0.0f : (t > 1.0f ? 1.0f : t);
+        return Dist2d(px, py, ax + t * dx, ay + t * dy);
+    }
+
+    bool IsHot(Mark const& m, time_t now) const
+    {
+        if (now - m.at >= kWindow)
+            return false;
+        size_t near = 0;
+        for (Mark const& o : marks)
+            if (o.map == m.map && now - o.at < kWindow && Dist2d(o.x, o.y, m.x, m.y) <= kRadius)
+                ++near;
+        return near >= kHot;
+    }
+
+    // True when walking from (fx, fy) to (tx, ty) on `map` ends on, or crosses,
+    // ground this bot has died on twice lately. A bot that already stands on
+    // the hot ground is not refused the way out of it: only the end spot is
+    // tested for that mark.
+    bool Avoids(uint32 map, float fx, float fy, float tx, float ty, time_t now) const
+    {
+        for (Mark const& m : marks)
+        {
+            if (m.map != map || !IsHot(m, now))
+                continue;
+            if (Dist2d(m.x, m.y, tx, ty) <= kRadius)
+                return true;
+            if (Dist2d(m.x, m.y, fx, fy) <= kRouteRadius)
+                continue;
+            if (SegmentDist(m.x, m.y, fx, fy, tx, ty) <= kRouteRadius)
+                return true;
+        }
+        return false;
+    }
+};
+
 struct NewRpgInfo
 {
     NewRpgInfo() : data(Idle{}) {}
