+#ifndef PLAYERBOTS_GRINDRESOURCEHOLD_H
+#define PLAYERBOTS_GRINDRESOURCEHOLD_H
+
+namespace GrindResourceHold
+{
+struct GrindResourceState
+{
+    bool alive;
+    bool inCombat;
+    unsigned int groupMemberCount;
+    bool hasMana;
+    unsigned int manaPercent;
+    unsigned int manaFloor;
+    bool hasDrink;
+    unsigned int healthPercent;
+    unsigned int healthFloor;
+    bool hasFood;
+};
+
+inline bool ShouldHoldGrindPull(GrindResourceState const& state)
+{
+    if (!state.alive || state.inCombat || state.groupMemberCount > 1)
+        return false;
+
+    return (state.hasMana && !state.hasDrink && state.manaPercent < state.manaFloor) ||
+           (!state.hasFood && state.healthPercent < state.healthFloor);
+}
+}  // namespace GrindResourceHold
+
+#endif
