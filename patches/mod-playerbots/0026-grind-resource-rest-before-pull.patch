+bool GrindResourceHoldTrigger::IsActive()
+{
+    Group* group = bot->GetGroup();
+    GrindResourceHold::GrindResourceState const state = {
+        bot->IsAlive(),
+        bot->IsInCombat(),
+        group ? group->GetMembersCount() : 1,
+        AI_VALUE2(bool, "has mana", "self target"),
+        AI_VALUE2(uint8, "mana", "self target"),
+        sPlayerbotAIConfig.LowMana,
+        AI_VALUE2(uint32, "item count", "water") > 0,
+        AI_VALUE2(uint8, "health", "self target"),
+        sPlayerbotAIConfig.LowHealth,
+        AI_VALUE2(uint32, "item count", "food") > 0,
+    };
+
+    return GrindResourceHold::ShouldHoldGrindPull(state);
+}
