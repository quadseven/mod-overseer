+bool RestBeforeGrindingAction::Execute(Event /*event*/)
+{
+    if (!bot->IsAlive() || bot->IsInCombat())
+        return false;
+
+    if (bot->isMoving())
+        bot->StopMoving();
+
+    bot->SetStandState(UNIT_STAND_STATE_SIT);
+    return true;
+}
