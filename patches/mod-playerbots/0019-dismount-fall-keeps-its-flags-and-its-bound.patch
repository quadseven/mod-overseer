+// CompleteDismount() leaves the falling flags on for a descent, and this is what
+// takes them off. EffectMovementGenerator::Finalize() returns before its flag
+// clear for a player, and a bot with no client sends no MSG_MOVE_FALL_LAND, so
+// nothing else would: the flag would outlive the descent, block MMAP routing and
+// freeze the fall baseline below. Only a descent CompleteDismount() recorded is
+// touched. A client's own fall has a finished spline and the flag too, and that
+// flag belongs to the client's packets. Where a client lands first, the flags are
+// already off and this changes nothing.
+void PlayerbotAI::FinishDismountDescent()
+{
+    if (!dismountDescentRunning || !bot->movespline->Finalized())
+        return;
+
+    dismountDescentRunning = false;
+
+    if (!bot->HasUnitMovementFlag(MOVEMENTFLAG_FALLING | MOVEMENTFLAG_FALLING_FAR))
+        return;
+
+    bot->RemoveUnitMovementFlag(MOVEMENTFLAG_FALLING | MOVEMENTFLAG_FALLING_FAR);
+    if (!bot->IsRooted())
+        bot->SendMovementFlagUpdate();
+}
+
