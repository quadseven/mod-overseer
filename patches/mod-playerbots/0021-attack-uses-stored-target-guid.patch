Subject: [PATCH] pass stored target GUIDs into attack actions

Resolve current and duel targets from GUIDs already retained by their values.
Never obtain a GUID by dereferencing a possibly stale AI-value Unit pointer.

diff --git a/src/Ai/Base/Actions/AttackAction.cpp b/src/Ai/Base/Actions/AttackAction.cpp
index be4a709..5f291ac 100644
--- a/src/Ai/Base/Actions/AttackAction.cpp
+++ b/src/Ai/Base/Actions/AttackAction.cpp
@@ -5,6 +5,8 @@
  */
 
 #include "AttackAction.h"
+#include "CurrentTargetValue.h"
+#include "DuelTargetValue.h"
 #include "CreatureAI.h"
 #include "Event.h"
 #include "LastMovementValue.h"
@@ -16,16 +18,33 @@
 #include "Unit.h"
 #include "WaitForAttackStrategy.h"
 
-bool AttackAction::Execute(Event /*event*/)
+ObjectGuid AttackAction::GetTargetGuid()
 {
-    Unit* target = GetTarget();
-    if (!target)
-        return false;
+    std::string const targetName = GetTargetName();
+    if (targetName == "current target")
+    {
+        auto* value = dynamic_cast<CurrentTargetValue*>(
+            botAI->GetAiObjectContext()->GetValue<Unit*>(targetName));
+        return value ? value->GetGuid() : ObjectGuid::Empty;
+    }
 
-    if (!target->IsInWorld())
-        return false;
+    if (targetName == "duel target")
+    {
+        auto* value = dynamic_cast<DuelTargetValue*>(
+            botAI->GetAiObjectContext()->GetValue<Unit*>(targetName));
+        return value ? value->GetGuid() : ObjectGuid::Empty;
+    }
+
+    if (targetName == "self target")
+        return bot->GetGUID();
 
-    return Attack(target);
+    return ObjectGuid::Empty;
+}
+
+bool AttackAction::Execute(Event /*event*/)
+{
+    ObjectGuid targetGuid = GetTargetGuid();
+    return targetGuid ? Attack(targetGuid) : false;
 }
 
 bool AttackMyTargetAction::Execute(Event /*event*/)
@@ -45,16 +64,16 @@ bool AttackMyTargetAction::Execute(Event /*event*/)
     }
 
     botAI->GetAiObjectContext()->GetValue<GuidVector>("prioritized targets")->Set({guid});
-    bool result = Attack(botAI->GetUnit(guid));
+    bool result = Attack(guid);
     if (result)
         context->GetValue<ObjectGuid>("pull target")->Set(guid);
 
     return result;
 }
 
-bool AttackAction::Attack(Unit* target, bool /*with_pet*/ /*true*/)
+bool AttackAction::Attack(ObjectGuid targetGuid, bool /*with_pet*/ /*true*/)
 {
-    if (!target)
+    if (!targetGuid)
     {
         if (verbose)
             botAI->TellError(PlayerbotTextMgr::instance().GetBotTextOrDefault(
@@ -63,16 +82,7 @@ bool AttackAction::Attack(Unit* target, bool /*with_pet*/ /*true*/)
         return false;
     }
 
-    // The target arrives as a raw pointer out of an AI value, and a value
-    // can outlive the unit it names: a despawned creature, a logged-out
-    // player, a unit that left for another map. The null check above and
-    // the IsInWorld() check below cannot see that state - the reaction
-    // read further down goes through the target's update fields, which
-    // are already gone by then, and faults. Resolve the target again by
-    // GUID, the way AttackMyTargetAction in this file already does: the
-    // accessor answers only for a unit on the bot's own map, so a target
-    // that is gone or elsewhere comes back null and is refused here.
-    target = botAI->GetUnit(target->GetGUID());
+    Unit* target = botAI->GetUnit(targetGuid);
-    if (!target)
+    if (!target || !target->IsInWorld() || target->GetMap() != bot->GetMap())
         return false;
 
@@ -99,7 +109,7 @@ bool AttackAction::Attack(Unit* target, bool /*with_pet*/ /*true*/)
 
     // Check if bot OR target is in prohibited zone/area (skip for duels)
     if ((target->IsPlayer() || target->IsPet()) &&
-        (!bot->duel || bot->duel->Opponent != target) &&
+        (!bot->duel || bot->duel->OpponentGuid != targetGuid) &&
         (sPlayerbotAIConfig.IsPvpProhibited(bot->GetZoneId(), bot->GetAreaId()) ||
         sPlayerbotAIConfig.IsPvpProhibited(target->GetZoneId(), target->GetAreaId())))
     {
@@ -183,8 +193,8 @@ bool AttackAction::Attack(Unit* target, bool /*with_pet*/ /*true*/)
     //     bot->GetSession()->HandleCancelMountAuraOpcode(emptyPacket);
     // }
 
-    ObjectGuid guid = target->GetGUID();
-    bot->SetSelection(target->GetGUID());
+    ObjectGuid guid = targetGuid;
+    bot->SetSelection(targetGuid);
 
     context->GetValue<Unit*>("old target")->Set(oldTarget);
     context->GetValue<Unit*>("current target")->Set(target);
@@ -230,9 +240,17 @@ bool AttackAction::Attack(Unit* target, bool /*with_pet*/ /*true*/)
     return true;
 }
 
-bool AttackDuelOpponentAction::isUseful() { return AI_VALUE(Unit*, "duel target"); }
+bool AttackDuelOpponentAction::isUseful()
+{
+    ObjectGuid guid = GetTargetGuid();
+    return guid && botAI->GetUnit(guid);
+}
 
-bool AttackDuelOpponentAction::Execute(Event /*event*/) { return Attack(AI_VALUE(Unit*, "duel target")); }
+bool AttackDuelOpponentAction::Execute(Event /*event*/)
+{
+    ObjectGuid guid = GetTargetGuid();
+    return guid ? Attack(guid) : false;
+}
 
 bool MeleeAction::isUseful()
 {
diff --git a/src/Ai/Base/Actions/AttackAction.h b/src/Ai/Base/Actions/AttackAction.h
index 2911924..3adf51a 100644
--- a/src/Ai/Base/Actions/AttackAction.h
+++ b/src/Ai/Base/Actions/AttackAction.h
@@ -8,6 +8,7 @@
 #define PLAYERBOTS_ATTACKACTION_H
 
 #include "MovementActions.h"
+#include "ObjectGuid.h"
 
 class PlayerbotAI;
 
@@ -19,7 +20,8 @@ public:
     bool Execute(Event event) override;
 
 protected:
-    bool Attack(Unit* target, bool with_pet = true);
+    ObjectGuid GetTargetGuid();
+    bool Attack(ObjectGuid targetGuid, bool with_pet = true);
 };
 
 class AttackMyTargetAction : public AttackAction
@@ -41,6 +43,7 @@ public:
 public:
     bool Execute(Event event) override;
     bool isUseful() override;
+    std::string const GetTargetName() override { return "duel target"; }
 };
 
 class MeleeAction : public AttackAction
diff --git a/src/Ai/Base/Value/CurrentTargetValue.h b/src/Ai/Base/Value/CurrentTargetValue.h
index 09bbc48..7041f21 100644
--- a/src/Ai/Base/Value/CurrentTargetValue.h
+++ b/src/Ai/Base/Value/CurrentTargetValue.h
@@ -22,6 +22,7 @@ public:
 
     Unit* Get() override;
     void Set(Unit* unit) override;
+    ObjectGuid GetGuid() const { return selection; }
 
 private:
     ObjectGuid selection;
diff --git a/src/Ai/Base/Value/DuelTargetValue.cpp b/src/Ai/Base/Value/DuelTargetValue.cpp
index 7d3e6ef..3f1ef06 100644
--- a/src/Ai/Base/Value/DuelTargetValue.cpp
+++ b/src/Ai/Base/Value/DuelTargetValue.cpp
@@ -7,4 +7,13 @@
 #include "DuelTargetValue.h"
 #include "Playerbots.h"
 
-Unit* DuelTargetValue::Calculate() { return bot->duel ? bot->duel->Opponent : nullptr; }
+Unit* DuelTargetValue::Calculate()
+{
+    ObjectGuid guid = GetGuid();
+    return guid ? botAI->GetUnit(guid) : nullptr;
+}
+
+ObjectGuid DuelTargetValue::GetGuid() const
+{
+    return bot->duel ? bot->duel->OpponentGuid : ObjectGuid::Empty;
+}
diff --git a/src/Ai/Base/Value/DuelTargetValue.h b/src/Ai/Base/Value/DuelTargetValue.h
index cb0a82d..6e5e9c8 100644
--- a/src/Ai/Base/Value/DuelTargetValue.h
+++ b/src/Ai/Base/Value/DuelTargetValue.h
@@ -18,6 +18,7 @@ public:
     DuelTargetValue(PlayerbotAI* botAI, std::string const name = "duel target") : TargetValue(botAI, name) {}
 
     Unit* Calculate() override;
+    ObjectGuid GetGuid() const;
 };
 
 #endif
