# The pins of the image the dev realm runs: the core, the mod-playerbots the
# realm builds, and every other module its worldserver carries. This file is
# the ONE copy. build.yml and check.adapter.yml both read it through
# scripts/read-realm-pins.sh, which fails (naming this file) when it is
# missing, a key is absent, or a SHA is not 40 lowercase hex characters.
#
# The deployment's own pin file stays the source of truth for the realm image
# (decision of 2026-10-27 on #574). The deployment's CI reads this file at the
# mod-overseer commit it pins and fails, naming each pin, when any value here
# differs from the realm's. That keeps a CI result here a statement about the
# realm's tree and not about a neighbour of it.
#
# mod-overseer itself is not listed: it is the checkout under test.
#
# Format: KEY=value, one per line, no quotes, no spaces around the equals sign.
#
# CORE_* and MODULE_* are what the realm runs. MODULE_REPO is the operator's
# mod-playerbots fork (upstream master plus the fall-damage commits), not
# upstream. HEADS_* are the core and mod-playerbots the NEXT roll moves to;
# check.adapter.yml compiles the adapter against both sets. They equal the
# realm's pins while no roll is pending.
#
# Bumping a pin: change it here, in the same change as the patches/ ports it
# needs. A roll that moves a module pin on the deployment side needs a
# mod-overseer commit carrying the same value, and moves the deployment to it.

CORE_REPO=https://github.com/mod-playerbots/azerothcore-wotlk.git
CORE_SHA=8a4e76eac8c4ccebf547113afe7b51d6c3e91641
MODULE_REPO=https://github.com/quadseven/mod-playerbots.git
MODULE_SHA=40884e9c135c1daf27ffd894a6047502a5701130

HEADS_CORE_REPO=https://github.com/mod-playerbots/azerothcore-wotlk.git
HEADS_CORE_SHA=8a4e76eac8c4ccebf547113afe7b51d6c3e91641
HEADS_MODULE_REPO=https://github.com/quadseven/mod-playerbots.git
HEADS_MODULE_SHA=40884e9c135c1daf27ffd894a6047502a5701130

# The other modules compiled into the same worldserver.
OLLAMA_CHAT_REPO=https://github.com/DustinHendrickson/mod-ollama-chat.git
OLLAMA_CHAT_SHA=906eb2a45f5b3b815a281977005371193517eb32
DUNGEON_CLEAR_REPO=https://github.com/quadseven/mod-dungeon-clear.git
DUNGEON_CLEAR_SHA=8e47c1a08efbcf13ab8f41730c5852baca52968a
JUNK_TO_GOLD_REPO=https://github.com/noisiver/mod-junk-to-gold.git
JUNK_TO_GOLD_SHA=2134690bb03899e5c9e44d0682e8e6abf0bbbaf2
AH_BOT_REPO=https://github.com/NathanHandley/mod-ah-bot-plus.git
