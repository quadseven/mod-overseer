########################################
# mod-overseer configuration
#
# EVERY KEY HERE IS OPTIONAL AND EVERY KEY HERE IS COMMENTED OUT. The module
# compiles a default for each one and uses it when the key is absent, so a
# worldserver that has never seen this file behaves exactly as a worldserver
# that has copied it unedited. Uncomment a line only to disagree with the
# default, and the value you type is then the one the module uses - there is no
# second place it could come from.
#
# WHY THIS FILE EXISTS AT ALL. Until infra#3744 the recruit policy was three
# `static constexpr` values in src/mod_overseer.cpp, which meant that changing
# how big the guild should be, or which levels it would ask, was a source edit,
# a pinned-SHA bump, an image build and a promote. AGENTS.md's reusability half
# is explicit about that shape: "Every value specific to one deployment ... is a
# variable, an environment variable, or a config file entry - never a literal
# baked into source." How large a guild wants to be is as deployment-specific as
# a hostname.
#
########################################

########################################
#
#    GUILD RECRUITING
#
#    The module's `guild shortlist` and `guild invite` verbs judge a candidate
#    against three things it cannot work out for itself: how big the guild is
#    trying to be, and the two ends of the level range it will ask inside.
#    Everything else the rule uses - which professions nobody holds, which
#    services no class brings, which combat roles nobody can fill - is read off
#    the guild's own members and is not configurable, because it is a
#    measurement rather than a decision.
#
#    THESE THREE GATE THE INVITE AND NOT MERELY THE SHORTLIST. A candidate
#    outside the band, or an invite issued once the roster has reached the
#    target size, is refused by RecruitVerdictFor on both paths. Widening these
#    is the only way to reach a candidate; it is not a display preference.
#

#
#    Overseer.Recruit.TargetSize
#        Description: The roster size the guild is recruiting toward. Once the
#                     guild holds this many members every further invite is
#                     refused `RosterFull`, and below it "the roster is under
#                     its target size" becomes a reason to invite somebody who
#                     closes no specific hole.
#
#                     40 is the size of a Molten Core or Blackwing Lair raid,
#                     which is what this realm's family guild is recruiting
#                     toward. It is deliberately not 15: the twenty other guilds
#                     on this realm each hold exactly 15, which is a fact about
#                     the neighbours and not a decision about this guild.
#
#                     0 disables the size gate entirely. Think before using it:
#                     with no size gate, "bench depth" is a reason to invite
#                     every eligible character on the realm, for ever.
#
#        Default:     40
#
#Overseer.Recruit.TargetSize = 40

#
#    Overseer.Recruit.LevelMin
#        Description: The lowest character level worth asking. 0 for no floor.
#
#                     A floor exists because a guild is for going to the same
#                     places and doing the same things, and the level column is
#                     the one honest thing the database can say about that. It
#                     is NOT a quality judgement: nothing in a character
#                     database says whether a player is any good, and this
#                     module scores nobody.
#
#                     10 is where a character has begun to be its class and has
#                     picked up trades. Below it this realm is mostly level 1
#                     characters that are barely characters yet.
#
#                     IT IS ALSO, TODAY, THE ONLY THING KEEPING TWO SERVICE
#                     CHARACTERS OUT. The auction-house bot's `Auctioneer` and
#                     the dungeon driver's `Dcdriver` are unguilded level 1
#                     characters on non-random-bot accounts, and `Auctioneer` is
#                     a Druid, which is the second-highest thing the recruit
#                     rule looks for. That protection holds only while they stay
#                     at level 1. infra#3648 is the real account-type filter.
#
#        Default:     10
#
#Overseer.Recruit.LevelMin = 10

#
#    Overseer.Recruit.LevelMax
#        Description: The highest character level worth asking. 0 for no
#                     ceiling.
#
#                     60 is this realm's MaxPlayerLevel, so the default gates on
#                     the only ceiling that is a fact rather than a preference.
#
#                     A CEILING BELOW THE POPULATION IS A REAL LEVER AND WORTH
#                     KNOWING ABOUT. On this realm 83 unguilded characters stand
#                     at exactly level 55 and every one of them is a Death
#                     Knight - one class at one level, large enough to fill a
#                     roster on its own once "bench depth" starts picking names
#                     alphabetically. Setting this to 54 excludes them; leaving
#                     it at 60 admits them. Neither is wrong, and the module
#                     cannot decide it, because what a raid should be composed
#                     of is not written down anywhere it can read.
#
#                     A ceiling BELOW the floor would be a gate that admits
#                     nobody, so it is not honoured: the module drops the
#                     ceiling and says so by answering a band with no upper end,
#                     because "recruits too widely" is a mistake somebody
#                     notices and "recruits nobody" is one nobody does.
#
#        Default:     60
#
#Overseer.Recruit.LevelMax = 60

########################################
#
#    THE RAID, AND GROUPS 1 THROUGH 8
#
#    `guild raid` prints a seating plan for the whole guild: who tanks, who
#    heals, and which of the eight raid groups each member stands in.
#    `guild raid form` turns the acting character's group into a raid and seats
#    into it whoever of that plan is actually in the world.
#
#    TWO OF THESE THREE KEYS ARE A DECISION AND THE THIRD IS A SAFETY CATCH.
#    How many of forty seats should tank and how many should heal is not written
#    down anywhere the module can read - it is the same sentence the recruit
#    ceiling above has to say about itself - so it is configuration, with a
#    default that argues for itself in src/overseer_decisions.h rather than
#    pretending to be measured. Everything ELSE about the layout is derived:
#    which class takes which seat, who is picked first, and which group anybody
#    ends up in are all rules, not settings, because they follow from the two
#    numbers plus the roster.
#

#
#    Overseer.Raid.Tanks
#        Description: How many of the forty seats are tanks.
#
#                     A raid night at this tier is a main tank on the boss, an
#                     off-tank on whatever the boss brought with it, and enough
#                     further tank-capable characters that the raid does not
#                     stop when one of them dies. Four is the smallest number
#                     that covers all three and still leaves thirty-six seats
#                     for the raid to be anything else.
#
#                     IT IS NOT A FLOOR ON WHO CAN TANK. The picker takes tanks
#                     in class order - warrior, death knight, druid, paladin -
#                     and that order is an opportunity-cost argument rather than
#                     a claim about who tanks best: a warrior who is not tanking
#                     is a melee damage seat, while a paladin or druid who is
#                     not tanking is a HEALER, which is the other scarce seat.
#
#                     SCALED DOWN FOR A SHORT ROSTER, rounded up. A guild of
#                     twelve gets two tanks rather than four, because four tanks
#                     and ten healers out of twelve characters is a raid with
#                     two damage dealers in it.
#
#        Default:     4
#
#Overseer.Raid.Tanks = 4

#
#    Overseer.Raid.Healers
#        Description: How many of the forty seats heal.
#
#                     A quarter of the raid. Forty-man content at this tier was
#                     run on roughly ten to twelve healers, and the number is
#                     bounded on both sides: too few and a raid dies to
#                     attrition it could have healed through, too many and it
#                     never kills anything before an enrage. Ten is the low end
#                     of that range, chosen deliberately - this realm's guild is
#                     levels 13 to 55, nowhere near the gear that makes healing
#                     cheap, and the honest direction to be wrong in is the one
#                     where the raid is slow rather than dead.
#
#                     HEALERS ARE SPREAD ONE PER GROUP before anybody gets a
#                     second, so this number is also how many groups are
#                     covered. Below eight, the low-numbered groups are covered
#                     first and the tanks are always covered.
#
#        Default:     10
#
#Overseer.Raid.Healers = 10

#
#    Overseer.Raid.ConvertRosterParty
#        Description: May `guild raid form` convert the party the roster
#                     characters are in into a raid.
#
#                     OFF BY DEFAULT, AND THE DEFAULT IS THE POINT OF THE KEY.
#                     Two facts make converting that particular group something
#                     nobody should be able to do by accident, and both are
#                     facts about the pinned core rather than preferences:
#
#                     1. IT CANNOT BE UNDONE. There is no ConvertToParty in the
#                        core - Group declares ConvertToLFG and ConvertToRaid
#                        and nothing that goes back. The only exit from a raid
#                        is to disband the group and form it again, losing the
#                        leader, the loot method and every instance binding.
#                     2. IT SPLITS THE ROSTER PARTY CHAT, which is the whole
#                        reason that party exists. Party chat inside a raid
#                        reaches the speaker's SUBGROUP only. While the group is
#                        an ordinary party everybody is in subgroup 0 and
#                        nothing changes; the moment a raid layout spreads five
#                        roster characters across five subgroups, a party line
#                        reaches whoever happens to share a subgroup with the
#                        speaker and nobody else.
#
#                     The gate is MORE THAN ONE enabled roster character in the
#                     group, not "any": the acting character is itself normally
#                     a roster character, because those are the ones with
#                     clients attached, so a gate on "any" would be a gate on
#                     everything. A group holding at most one roster character
#                     converts with this left alone.
#
#        Default:     0
#
#Overseer.Raid.ConvertRosterParty = 0
#
########################################
#
#    THE ROSTER AND ITS CLIENTS
#
#    Overseer.RequireClient
#        Description: Whether a roster character must have a game client
#                     attached to stay in the world.
#
#                     ON, WHICH IS THE DEFAULT AND THE RULE THIS MODULE WAS
#                     BUILT AROUND. KeepRosterAttended sweeps the roster every
#                     pass and evicts any character that is in the world as a
#                     headless bot, because "the family only plays on camera".
#                     A POV nobody can see is not a character playing; it is a
#                     login, an eviction and a login again, for ever.
#
#                     OFF, WHICH IS A TRADE AND NOT A FIX. A roster character
#                     that is in the world as a bot is left alone. The drives
#                     still steer it, it still takes jobs, it still travels -
#                     what is given up is the promise that every one of the
#                     five is watchable. Anything reasoning about a POV being
#                     observable, the stream feature most of all, is reasoning
#                     about a promise this key withdraws.
#
#                     WHY IT IS A KEY AT ALL. How many of the five can be given
#                     a client is a fact about the MACHINE the clients run on,
#                     not about this module. A host that renders five of them
#                     pays nothing for the rule. A host that renders one - a
#                     small box with no usable GPU, where every client is a
#                     software rasteriser burning a core and a half - is a host
#                     where the rule is the difference between a family that
#                     plays and a roster four-fifths empty. Until now the only
#                     way to disagree with it was to edit mod_overseer.cpp and
#                     build an image.
#
#                     Leave it on wherever there are clients to spare.
#
#        Default:     1
#
#Overseer.RequireClient = 1
